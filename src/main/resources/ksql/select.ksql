-- ============================ AUTHOR_STREAM ============================
SELECT * FROM AUTHOR_STREAM;
SELECT * FROM AUTHOR_STREAM EMIT CHANGES;


-- ============================ AUTHOR_SRC_TABLE ============================
SELECT * FROM AUTHOR_SRC_TABLE;
SELECT * FROM AUTHOR_SRC_TABLE EMIT CHANGES;


-- ============================ AUTHOR_PUBLISHES_TABLE ============================
SELECT `EMAIL`, `TOTAL_PUBLISHES`,
    TIMESTAMPTOSTRING(ROWTIME, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS `EVENT_TIME`
FROM AUTHOR_PUBLISHES_TABLE;

SELECT *, TIMESTAMPTOSTRING(ROWTIME, 'yyyy-MM-dd HH:mm:ss', 'UTC') AS `EVENT_TIME`
FROM AUTHOR_PUBLISHES_TABLE EMIT CHANGES;


-- ============================ AUTHOR_PUBLISHES_BY_CATEGORY_TABLE ============================
SELECT * FROM AUTHOR_PUBLISHES_BY_CATEGORY_TABLE;
SELECT * FROM AUTHOR_PUBLISHES_BY_CATEGORY_TABLE EMIT CHANGES;
